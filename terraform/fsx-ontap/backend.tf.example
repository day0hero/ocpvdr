# -----------------------------------------------------------------------------
# S3 Backend Configuration for Terraform State
# -----------------------------------------------------------------------------
# 
# This file shows the backend configuration for storing Terraform state in S3.
# Copy this to backend.tf and update the values, OR let Ansible generate it.
#
# Before using this backend, you must create the S3 bucket and DynamoDB table:
#   make setup-terraform-state
#
# Or manually:
#   ./scripts/setup-terraform-state-s3.sh
#
# -----------------------------------------------------------------------------

terraform {
  backend "s3" {
    # S3 bucket for state storage
    # Replace with your bucket name (create with: make setup-terraform-state)
    bucket = "REPLACE_WITH_YOUR_BUCKET_NAME"
    
    # Path within the bucket for the state file
    key = "fsx-ontap/terraform.tfstate"
    
    # AWS region where the bucket is located
    region = "us-east-1"
    
    # Enable encryption at rest
    encrypt = true
    
    # DynamoDB table for state locking (prevents concurrent modifications)
    dynamodb_table = "terraform-state-lock"
    
    # Optional: Use specific AWS profile
    # profile = "default"
  }
}
