# -----------------------------------------------------------------------------
# S3 Backend Configuration for Terraform State
# Generated by Ansible - Do not edit manually
# -----------------------------------------------------------------------------

terraform {
  backend "s3" {
    bucket         = "{{ terraform_state_bucket }}"
    key            = "{{ terraform_state_key }}"
    region         = "{{ terraform_state_bucket_region }}"
    encrypt        = true
    use_lockfile   = true
  }
}
